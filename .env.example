# Google Cloud Configuration
# Path to your service account JSON file (needs Drive API access)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google Drive folder ID where PaperPile stores PDFs
# (Get this from your Drive folder URL: drive.google.com/drive/folders/FOLDER_ID)
GOOGLE_DRIVE_FOLDER_ID=1gluNDqRQkyqxa_WIASaaoNEItrDlETkn

# Gemini API
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Anthropic / Claude API (writes the podcast dialogue script)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_SCRIPT_MODEL=claude-opus-5
CLAUDE_TITLE_MODEL=claude-haiku-4-5

# GitHub Configuration (for uploading releases)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=username/research-radio

# Feed Configuration
FEED_URL=https://raw.githubusercontent.com/fabiogiglietto/toread/main/output/feed.json

# fg-zettelkasten structured summaries (optional) — scaffold for the script.
# Defaults to the public fg-zettelkasten repo; override only if it moves. Must
# be a GitHub Contents API directory: the raw CDN caches ~5 minutes, and the
# summary is committed moments before research-radio runs, so a raw fetch
# routinely misses a brand-new paper.
ZETTELKASTEN_SUMMARY_BASE=https://api.github.com/repos/fabiogiglietto/fg-zettelkasten/contents/data/summaries

# Related work — weave links to papers the show already covered into the
# dialogue. Candidates come from docs/episodes.json; the substance comes from
# the fg-zettelkasten vault, fetched once per run as a tarball (public, no auth).
RELATED_WORK_ENABLED=true
CLAUDE_CONNECTIONS_MODEL=claude-opus-5
RELATED_WORK_MAX=3
ZETTELKASTEN_TARBALL_URL=https://api.github.com/repos/fabiogiglietto/fg-zettelkasten/tarball/main

# Per-episode platform links (optional)
# Apple per-episode URLs are resolved from the free iTunes Lookup API by show id.
# Spotify links point at the show page (its episode endpoint needs a user token).
APPLE_PODCAST_ID=1866587707
SPOTIFY_SHOW_ID=5V99ieB2ljNvcwPZ53EoPX

# Podcast Metadata
PODCAST_TITLE=Research Radio
PODCAST_DESCRIPTION=AI-generated podcast discussions of academic papers
PODCAST_AUTHOR=Research Radio
PODCAST_EMAIL=your-email@example.com
PODCAST_WEBSITE=https://username.github.io/research-radio

# TTS Voice Configuration (optional)
# Available voices: Puck, Charon, Kore, Fenrir, Aoede
TTS_HOST_VOICE=Kore
TTS_COHOST_VOICE=Charon
